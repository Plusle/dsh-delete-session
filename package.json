{
  "name": "delete-session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Delete a DSH session from its row menu — log, title and list cache. · 从会话菜单彻底删除一个 DSH 会话：日志、标题与列表缓存。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plusle/dsh-delete-session.git"
  },
  "homepage": "https://github.com/Plusle/dsh-delete-session#readme",
  "bugs": {
    "url": "https://github.com/Plusle/dsh-delete-session/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
